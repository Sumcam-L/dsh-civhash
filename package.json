{
  "name": "@dsh-external/dsh-civhash",
  "version": "0.0.1",
  "description": "把 CivNexus6 ConsoleApplication1 的 hash 功能做成 civhash.exe CLI，注册为 AI 可调用的 civhash tool",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sumcam-L/dsh-civhash.git"
  },
  "homepage": "https://github.com/Sumcam-L/dsh-civhash#readme",
  "bugs": {
    "url": "https://github.com/Sumcam-L/dsh-civhash/issues"
  },
  "keywords": [
    "civ6",
    "civilization-vi",
    "civnexus6",
    "crc32",
    "fnv1a",
    "hash",
    "dsh-plugin"
  ],
  "os": [
    "win32"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:cli": "bash cli/build.sh",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  }
}
